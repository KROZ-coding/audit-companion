APP_ENV=production
APP_NAME=审计智能学伴 API
PERSISTENCE_ENABLED=true
PASSWORD_HASH_CONCURRENCY=8
COOKIE_SECURE=true
DATA_DIR=/var/lib/audit-companion
ALLOWED_HOSTS=example.edu.cn
CORS_ORIGINS=

# Replace every placeholder before starting the public service.
MAXKB_URL=https://maxkb.example.edu.cn
MAXKB_API_KEY=replace-with-a-real-server-side-secret
MAXKB_DATASET_IDS=replace-with-course-dataset-id

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-a-real-server-side-secret
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=360
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=32
LLM_QUEUE_SIZE=60
LLM_QUEUE_TIMEOUT_SECONDS=240
# Optional LLM_PROVIDERS_JSON supports separate student/teacher/grading pools.
LLM_REASONING_EFFORT=

KNOWLEDGE_DIR=
KNOWLEDGE_INDEX_PATH=
KNOWLEDGE_TOP_K=4
REGISTRATION_RATE_LIMIT=100
CHAT_DAILY_LIMIT=50
