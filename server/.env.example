# Local development template only. Never expose development mode on the public internet.
APP_ENV=development
APP_NAME=审计智能学伴 API
MAXKB_URL=
MAXKB_API_KEY=
MAXKB_DATASET_IDS=
# Optional JSON mapping for multi-course deployments, e.g. {"audit-101":["dataset-id"]}
MAXKB_COURSE_DATASETS=
# 大模型（OpenAI 兼容接口）。留空则答疑/主观题批改/学情报告回退为规则模式。
# 百炼示例：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=360
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=32
LLM_QUEUE_SIZE=60
LLM_QUEUE_TIMEOUT_SECONDS=240
# Optional per-provider rate limits (requests/minute and tokens/minute, 0 = unlimited).
# Set per provider via "rpm_limit"/"tpm_limit" in LLM_PROVIDERS_JSON; these env vars are the defaults.
LLM_RPM_LIMIT=0
LLM_TPM_LIMIT=0
# Pre-flight output token estimate used for TPM admission before real usage is known.
LLM_TOKEN_OUTPUT_ESTIMATE=512
# Optional completion cap per request (tokens, 0 = unlimited). Bounds runaway answers.
LLM_MAX_TOKENS=0
# Optional channel pools replace the legacy LLM_* endpoint; each api_key_env points to a separate secret variable.
# Add a channel="shared" entry explicitly if a shared fallback is intended.
# LLM_STUDENT_PRIMARY_KEY=
# LLM_STUDENT_BACKUP_KEY=
# LLM_TEACHER_KEY=
# LLM_PROVIDERS_JSON=[{"name":"student-primary","channel":"student","base_url":"https://relay.example/v1","api_key_env":"LLM_STUDENT_PRIMARY_KEY","model":"model-a","max_concurrency":8,"queue_size":60,"priority":10,"rpm_limit":120,"tpm_limit":200000},{"name":"student-backup","channel":"student","base_url":"https://relay.example/v1","api_key_env":"LLM_STUDENT_BACKUP_KEY","model":"model-b","max_concurrency":4,"queue_size":30,"priority":20},{"name":"teacher-main","channel":"teacher","base_url":"https://relay.example/v1","api_key_env":"LLM_TEACHER_KEY","model":"model-c","max_concurrency":2,"queue_size":10,"priority":10}]
# 推理控制:实测 glm-5.3-flash 经中继响应 reasoning_effort=none,
# 关闭隐形思考后单次答疑约快 2-4 倍且 token 省约 70%;普通模型可留空试效果
LLM_REASONING_EFFORT=
# 本地知识库：索引由 build_knowledge_index.py 生成，默认 DATA_DIR/knowledge/index.pkl
KNOWLEDGE_DIR=
KNOWLEDGE_INDEX_PATH=
KNOWLEDGE_TOP_K=4
DATA_DIR=./data
PERSISTENCE_ENABLED=true
PASSWORD_HASH_CONCURRENCY=8
COOKIE_SECURE=false
CORS_ORIGINS=
# Public deployment: set APP_ENV=production, COOKIE_SECURE=true,
# ALLOWED_HOSTS=your.real.domain and CORS_ORIGINS to only required external origins.
# If a separate local frontend runs on Vite, explicitly add http://localhost:5173 for development.
